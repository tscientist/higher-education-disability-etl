# Google Cloud Configuration
GCP_PROJECT_ID=your-project-id
GCP_CREDENTIALS_PATH=credentials.json

# MongoDB Configuration
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/?appName=your-app-name
MONGO_DATABASE=higher_education
MONGO_COLLECTION=students

# BigQuery Configuration
BIGQUERY_DATASET=seu_dataset
BIGQUERY_TABLE=sua_tabela

# BigQuery Test Resources
BIGQUERY_TEST_DATASET=ppgti_etl_test
BIGQUERY_TEST_TABLE=etl_test_table

# ETL Configuration - Year range
ETL_START_YEAR=2022
ETL_END_YEAR=2022

# ETL Configuration - Batch Processing
# Processa dados em batches de N registros por vez
# Útil para grandes volumes de dados
ETL_BATCH_SIZE=20000
ETL_ENABLE_BATCH_MODE=true

# ETL Configuration - Optional limit for test runs
# ETL_LIMIT=5000
